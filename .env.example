# Copiar este archivo a .env y completar. El archivo .env nunca se sube al repositorio.

# Base de datos con permisos de escritura. La usan solo los scripts de carga (seed e ingesta).
# Este valor es el de la base local de docker compose, que es la que se uso y probo.
# Para otra base PostgreSQL con pgvector, poner aca su cadena de conexion (no se probo).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetria

# Base de datos con el rol agent_ro (solo lectura). La usa el agente.
# Se crea con db/roles.sql, que define la contrasena del rol.
DATABASE_URL_RO=postgresql://agent_ro:cambiar_esta_clave@localhost:5432/telemetria

# Modelo de lenguaje (Gemini). Crear la clave en Google AI Studio.
GEMINI_API_KEY=
# gemini-3.5-flash tiene 20 pedidos por dia en la capa gratuita y no alcanza para la evaluacion.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Observabilidad con LangSmith (opcional pero necesaria para el criterio de promocion).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-sql-telemetria

# Limites del agente
SQL_MAX_ROWS=50
SQL_TIMEOUT_MS=8000
SQL_MAX_RETRIES=2
RETRIEVAL_TOP_K=4

# Despliegue en la nube (opcional, ver README). Solo para la base de Neon; no reemplazan a las de arriba.
# Cadena pooled de Neon del dueno del proyecto. Se usa solo para cargar la base desde la maquina del autor.
NUBE_DATABASE_URL=
# Cadena pooled de Neon con el rol agent_ro. Es la unica que se carga en Streamlit (como DATABASE_URL_RO).
NUBE_DATABASE_URL_RO=
